{
  "name": "design-notes",
  "version": "1.1.3",
  "description": "Design notes toolkit — the design-notes skill bootstraps the docs/design-notes scaffold from bundled templates and creates/updates notes; /design-notes, /cdn, and /udn are thin prompt shortcuts over it.",
  "author": "jIRI-san",
  "license": "MIT",
  "tags": [
    "skill",
    "prompt",
    "documentation",
    "design-notes"
  ],
  "dependencies": [],
  "status": "stable",
  "files": [
    {
      "src": "prompts/design-notes.prompt.md",
      "dest": "prompts/design-notes.prompt.md"
    },
    {
      "src": "prompts/cdn.prompt.md",
      "dest": "prompts/cdn.prompt.md"
    },
    {
      "src": "prompts/udn.prompt.md",
      "dest": "prompts/udn.prompt.md"
    },
    {
      "src": "skills/design-notes/SKILL.md",
      "dest": "skills/design-notes/SKILL.md"
    },
    {
      "src": "skills/design-notes/assets/templates/design-notes-index.template.md",
      "dest": "skills/design-notes/assets/templates/design-notes-index.template.md"
    },
    {
      "src": "skills/design-notes/assets/templates/design-note-writing-style.template.md",
      "dest": "skills/design-notes/assets/templates/design-note-writing-style.template.md"
    },
    {
      "src": "skills/design-notes/scripts/Initialize-DesignNotes.ps1",
      "dest": "skills/design-notes/scripts/Initialize-DesignNotes.ps1"
    }
  ],
  "scaffolds": [
    {
      "path": "docs/design-notes/.design-notes.md",
      "mode": "literal",
      "owner": "Initialize-DesignNotes.ps1",
      "trigger": "tier scaffold on first run"
    },
    {
      "path": "docs/design-notes/project",
      "mode": "literal",
      "owner": "Initialize-DesignNotes.ps1",
      "trigger": "tier scaffold on first run"
    },
    {
      "path": "docs/design-notes/project/design-note-writing-style.design.md",
      "mode": "literal",
      "owner": "Initialize-DesignNotes.ps1",
      "trigger": "tier scaffold on first run"
    }
  ],
  "evals": {
    "path": "evals/",
    "status": "none",
    "lastRun": null
  }
}
