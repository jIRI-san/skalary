  "scaffolds": [
    {
      "path": "docs/review-ledger/.archive",
      "mode": "literal",
      "owner": "Remove-LedgerEntry.ps1",
      "trigger": "first ledger prune"
    },
    {
      "path": "docs/review-ledger/.archive/<category>.md",
      "mode": "parameterized",
      "owner": "Remove-LedgerEntry.ps1",
      "trigger": "first ledger prune",
      "confine": "Resolve-RepoPath",
      "values": [
        "consistency",
        "error-handling",
        "observability",
        "performance",
        "plan-structure",
        "security",
        "testing"
      ]
    },
    {
      "path": "docs/review-ledger/<category>.md",
      "mode": "parameterized",
      "owner": "Add-LedgerEntry.ps1",
      "trigger": "first harvest append",
      "confine": "Resolve-LedgerPath",
      "values": [
        "consistency",
        "error-handling",
        "observability",
        "performance",
        "plan-structure",
        "security",
        "testing"
      ]
    },
    {
      "path": "docs/implementation-plans/<plan>/assets/logs/learning-overflow/**",
      "mode": "parameterized",
      "owner": "Add-WorkflowNote.ps1",
      "trigger": "first assets-layout learning overflow",
      "confine": "Resolve-PlanAssetPath"
    },
    {
      "path": "docs/implementation-plans/<plan>/learning-overflow/**",
      "mode": "parameterized",
      "owner": "Add-WorkflowNote.ps1",
      "trigger": "first legacy-layout learning overflow",
      "confine": "Resolve-PlanAssetPath"
    },
    {
      "path": "docs/implementation-plans/<plan>/assets/harvest-receipts/**",
      "mode": "parameterized",
      "owner": "Invoke-PhaseHarvest.ps1",
      "trigger": "first assets-layout phase harvest",
      "confine": "Resolve-PlanAssetPath"
    },
    {
      "path": "docs/implementation-plans/<plan>/harvest-receipts/**",
      "mode": "parameterized",
      "owner": "Invoke-PhaseHarvest.ps1",
      "trigger": "first legacy-layout phase harvest",
      "confine": "Resolve-PlanAssetPath"
    }
  ],
  "evals": {
    "path": "evals/",
    "status": "none",
    "lastRun": null
  }
}
