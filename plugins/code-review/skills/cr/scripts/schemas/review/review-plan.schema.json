{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/schemas/review/review-plan.schema.json",
  "title": "Skalary Review Plan (frozen)",
  "description": "Plan c21cdc D4/D16. The immutable planned-task set `Freeze` publishes before any reviewer is dispatched: the run identity, the bounded scope, the declared roster, the invocation budget and one record per planned concern/model slot. It carries no outcome, no finding and no timestamp, so an identical replay canonicalizes to identical bytes. Every limit is embedded from `review-limits.schema.json`; unique task ids and unique concern/model slots are byte- and cross-record facts the semantic layer owns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "reviewType",
    "contentTrust",
    "scope",
    "scopeAuthority",
    "roster",
    "modelSelection",
    "invocationBudget",
    "tasks"
  ],
  "properties": {
    "schema": { "$ref": "#/$defs/discriminator" },
    "runId": { "$ref": "#/$defs/runId" },
    "reviewType": { "$ref": "#/$defs/reviewType" },
    "contentTrust": {
      "$ref": "#/$defs/contentTrust"
    },
    "scope": { "$ref": "#/$defs/scope" },
    "scopeAuthority": {
      "$ref": "#/$defs/scopeAuthority"
    },
    "roster": { "$ref": "#/$defs/roster" },
    "modelSelection": {
      "$ref": "#/$defs/modelSelection"
    },
    "restart": {
      "$ref": "#/$defs/restartRecord"
    },
    "invocationBudget": { "$ref": "#/$defs/invocationBudget" },
    "tasks": { "$ref": "#/$defs/plannedTasks" }
  },
  "$defs": {
    "discriminator": { "const": "skalary/review-plan@1" },
    "plannedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "concern", "model"],
      "properties": {
        "taskId": { "$ref": "#/$defs/taskId" },
        "concern": { "$ref": "#/$defs/concern" },
        "model": { "$ref": "#/$defs/model" }
      }
    },
    "plannedTasks": { "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/plannedTask" } },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "reviewType": { "type": "string", "enum": ["code", "design"] },
    "contentTrust": {
      "const": "reviewer-authored-data"
    },
    "scope": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "scopeMode": {
      "type": "string",
      "enum": [
        "branch",
        "uncommitted",
        "paths",
        "design"
      ]
    },
    "sourceIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scopePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scopePathStatus": {
      "type": "string",
      "enum": [
        "added",
        "modified",
        "deleted",
        "renamed",
        "untracked"
      ]
    },
    "scopePathRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/scopePath"
        },
        "status": {
          "$ref": "#/$defs/scopePathStatus"
        }
      }
    },
    "scopePathRecords": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/scopePathRecord"
      }
    },
    "designSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "plan",
            "design-note",
            "rfc"
          ]
        },
        "path": {
          "$ref": "#/$defs/scopePath"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "scopeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "paths",
        "digest"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/scopeMode"
        },
        "base": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "head": {
          "$ref": "#/$defs/sourceIdentity"
        },
        "paths": {
          "$ref": "#/$defs/scopePathRecords"
        },
        "designSource": {
          "$ref": "#/$defs/designSource"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "model": { "type": "string", "minLength": 1, "maxLength": 128 },
    "roster": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/model" } },
    "modelPreflight": {
      "type": "string",
      "enum": [
        "available",
        "unavailable",
        "not-run"
      ]
    },
    "modelDegradation": {
      "type": "string",
      "enum": [
        "none",
        "fallback",
        "preflight-unavailable"
      ]
    },
    "modelSelectionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "declared",
        "preflight",
        "degradation",
        "servedIdentity"
      ],
      "properties": {
        "requested": {
          "$ref": "#/$defs/model"
        },
        "declared": {
          "$ref": "#/$defs/model"
        },
        "preflight": {
          "$ref": "#/$defs/modelPreflight"
        },
        "fallback": {
          "$ref": "#/$defs/model"
        },
        "degradation": {
          "$ref": "#/$defs/modelDegradation"
        },
        "servedIdentity": {
          "const": "unverified"
        }
      }
    },
    "modelSelection": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/modelSelectionRecord"
      }
    },
    "restartRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentRunId",
        "parentRunDigest",
        "restartOrdinal",
        "partitionIndex",
        "partitionCount"
      ],
      "properties": {
        "parentRunId": {
          "$ref": "#/$defs/runId"
        },
        "parentRunDigest": {
          "$ref": "#/$defs/digest"
        },
        "restartOrdinal": {
          "const": 1
        },
        "partitionIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "partitionCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        }
      }
    },
    "invocationBudget": { "type": "integer", "minimum": 1, "maximum": 128 },
    "taskId": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$" },
    "concern": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
