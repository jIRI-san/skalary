  "scaffolds": [
    {
      "path": "docs/feedback/queue.md",
      "mode": "literal",
      "owner": "Update-FeedbackQueue.ps1",
      "trigger": "first queued /pfb marker"
    },
    {
      "path": "docs/self-improvement/state.json",
      "mode": "literal",
      "owner": "SiStateStore.psm1",
      "trigger": "first SI due or repaired manifest"
    },
    {
      "path": "docs/self-improvement/runs/<yyyy>/<mm>/<run>.json",
      "mode": "parameterized",
      "owner": "SiStateStore.psm1",
      "trigger": "SI run begin or update",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/archive/<yyyy>/<mm>/<run>.json",
      "mode": "parameterized",
      "owner": "Archive-SiState.ps1",
      "trigger": "completed-run archive",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/backups/<observation>/**",
      "mode": "parameterized",
      "owner": "Repair-SiState.ps1",
      "trigger": "repair apply journal and backup",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/quarantine/index.json",
      "mode": "literal",
      "owner": "Repair-SiState.ps1",
      "trigger": "first corrupt artifact quarantine"
    },
    {
      "path": "docs/self-improvement/quarantine/<observation>/**",
      "mode": "parameterized",
      "owner": "Repair-SiState.ps1",
      "trigger": "corrupt artifact quarantine",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/repair-observations/<observation>.json",
      "mode": "parameterized",
      "owner": "Repair-SiState.ps1",
      "trigger": "repair snapshot",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/repair-receipts/<receipt>.json",
      "mode": "parameterized",
      "owner": "Repair-SiState.ps1",
      "trigger": "repair apply or rollback completion",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/repair-receipts",
      "mode": "literal",
      "owner": "Repair-SiState.ps1",
      "trigger": "repair receipt enumeration"
    },
    {
      "path": "docs/self-improvement/resolver-receipts/<receipt>.json",
      "mode": "parameterized",
      "owner": "Get-SiHarvest.ps1",
      "trigger": "resolver receipt issuance",
      "confine": "Resolve-SiStatePath"
    },
    {
      "path": "docs/self-improvement/resolver-receipts",
      "mode": "literal",
      "owner": "Get-SiHarvest.ps1",
      "trigger": "resolver receipt verification"
    },
    {
      "path": "docs/self-improvement/harvest-index.json",
      "mode": "literal",
      "owner": "Get-SiHarvest.ps1",
      "trigger": "bounded SI evidence scan"
    }
  ],
  "evals": {
    "path": "evals/",
    "status": "none",
    "lastRun": null
  }
}
