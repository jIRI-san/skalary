{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/plugins/self-improvement/schemas/resolver-receipt.schema.json",
  "title": "Self-improvement resolver receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "receiptId", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": { "$ref": "#/$defs/sha256" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "dueId",
        "runId",
        "pinnedBaseOid",
        "snapshotDigest",
        "selectedDigest",
        "rankedSetDigest",
        "candidates"
      ],
      "properties": {
        "protocol": { "const": "si-resolver-receipt-v1" },
        "dueId": { "$ref": "#/$defs/sha256" },
        "runId": { "$ref": "#/$defs/sha256" },
        "pinnedBaseOid": { "$ref": "#/$defs/gitOid" },
        "snapshotDigest": { "$ref": "#/$defs/sha256" },
        "selectedDigest": { "$ref": "#/$defs/sha256" },
        "rankedSetDigest": { "$ref": "#/$defs/sha256" },
        "candidates": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" }
  }
}
