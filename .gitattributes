# Force LF for all text files. Registry generation also hashes Git-clean-filtered
# bytes so canonical hashes remain correct in CRLF working trees.
* text=auto eol=lf

# Shell scripts must use LF — they run inside the Linux autopilot container.
*.sh text eol=lf
plugins/autopilot/scripts/container-entrypoint.sh text eol=lf
.github/skills/autopilot/scripts/container-entrypoint.sh text eol=lf
