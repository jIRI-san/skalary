# Autopilot transient artifacts (never committed)
.autopilot-halt
.autopilot-finalize-needed
.autopilot-rebundle-needed
# Copilot CLI --share output written into the container work tree; the host
# extracts these to the plan folder. Ignored so the termination handler's
# `git add -A` cannot sweep megabytes of transcript into a recovery commit.
session-transcript-*.md

# Plugin install runtime state (receipts, tmp staging) — never committed
.github/.skalary/

# Live plan review state is transient. Finalized `<uuid>.review.md` and
# `<uuid>.receipt.json` siblings remain trackable under the same reviews directory.
docs/implementation-plans/**/assets/reviews/*/
docs/implementation-plans/**/reviews/*/
docs/implementation-plans/**/assets/reviews/.*.finalize.lock
docs/implementation-plans/**/reviews/.*.finalize.lock

# Autopilot host-command configuration — machine-specific, never committed.
# `.autopilot.json` is deliberately tracked: it is the run contract (model, timeouts,
# build/test commands) and the container infers those commands when it is absent.
# It carries auth *modes*, never tokens.
.autopilot.host.json

# Eval harness local outputs/config
.eval-report.json
.eval.config.json
.eval-artifacts/
tests/evals/output/

# waza local cache + session logs (never committed)
.waza-cache/
.waza/
tests/evals/**/result*.json

# Pester CI test output
testResults.xml
# Per-platform NUnit reports written by Run-UnitTests.ps1 -TestResultPath (CI uploads them
# as artifacts; a local run must not offer them for commit).
artifacts/
