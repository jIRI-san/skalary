{
  "_comment": "Copy to .eval.config.json (gitignored) and set real values for local LLM eval runs.",
  "_waza": "For waza specs the agent model + judge model slugs live in each plugins/<name>/evals/waza/eval.yaml (config.model / config.judge_model); tool version pins live in tools/eval-tools.psd1. This file holds only judge/threshold tuning + Credential Manager auth targets. 'judgeModel' below applies to the legacy EvalLlm.psm1 backend still used by the design-notes cases until Phase 4.",
  "judgeModel": "<slug>",
  "credentialTarget": "copilot-eval",
  "credentialTargets": ["copilot-eval", "copilot-autopilot"],
  "temperature": 0,
  "passThreshold": 0.7,
  "timeoutSeconds": 300
}
