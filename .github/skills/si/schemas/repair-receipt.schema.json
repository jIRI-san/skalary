{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/plugins/self-improvement/schemas/repair-receipt.schema.json",
  "title": "Self-improvement repair receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "receiptId",
    "observationId",
    "mode",
    "beforeDigest",
    "afterDigest",
    "createdAtUtc"
  ],
  "properties": {
    "protocol": { "const": "si-repair-receipt-v1" },
    "receiptId": { "$ref": "#/$defs/sha256" },
    "observationId": { "$ref": "#/$defs/sha256" },
    "mode": { "enum": ["apply", "rollback"] },
    "beforeDigest": { "$ref": "#/$defs/sha256" },
    "afterDigest": { "$ref": "#/$defs/sha256" },
    "createdAtUtc": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
