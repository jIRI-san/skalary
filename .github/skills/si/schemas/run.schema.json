{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/plugins/self-improvement/schemas/run.schema.json",
  "title": "Self-improvement run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "dueId",
    "status",
    "createdAtUtc",
    "updatedAtUtc",
    "completedAtUtc",
    "provenance",
    "rankedSet",
    "choices",
    "proposalPr"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "runId": { "$ref": "#/$defs/sha256" },
    "dueId": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": [
        "resumable",
        "ranked",
        "proposal-pending",
        "declined-before-ranking",
        "no-candidates",
        "completed"
      ]
    },
    "createdAtUtc": { "$ref": "#/$defs/timestamp" },
    "updatedAtUtc": { "$ref": "#/$defs/timestamp" },
    "completedAtUtc": {
      "anyOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoId", "planId", "sourceCommit", "pinnedBaseOid", "resolverReceiptId"],
      "properties": {
        "repoId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "planId": { "type": "string", "pattern": "^(?:[0-9a-f]{6}|[0-9]{3})$" },
        "sourceCommit": { "$ref": "#/$defs/gitOid" },
        "pinnedBaseOid": { "$ref": "#/$defs/gitOid" },
        "resolverReceiptId": {
          "anyOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "rankedSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest", "candidates"],
      "properties": {
        "count": { "type": "integer", "minimum": 0, "maximum": 5 },
        "digest": { "$ref": "#/$defs/sha256" },
        "candidates": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/$defs/candidate" }
        }
      }
    },
    "choices": {
      "type": "array",
      "maxItems": 5,
      "items": { "$ref": "#/$defs/choice" }
    },
    "proposalPr": { "$ref": "#/$defs/nullableProposalPr" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "rankedSet": {
              "properties": {
                "count": { "const": 0 },
                "candidates": { "maxItems": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "rankedSet": {
              "properties": {
                "count": { "const": 1 },
                "candidates": { "minItems": 1, "maxItems": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "rankedSet": {
              "properties": {
                "count": { "const": 2 },
                "candidates": { "minItems": 2, "maxItems": 2 }
              }
            }
          }
        },
        {
          "properties": {
            "rankedSet": {
              "properties": {
                "count": { "const": 3 },
                "candidates": { "minItems": 3, "maxItems": 3 }
              }
            }
          }
        },
        {
          "properties": {
            "rankedSet": {
              "properties": {
                "count": { "const": 4 },
                "candidates": { "minItems": 4, "maxItems": 4 }
              }
            }
          }
        },
        {
          "properties": {
            "rankedSet": {
              "properties": {
                "count": { "const": 5 },
                "candidates": { "minItems": 5, "maxItems": 5 }
              }
            }
          }
        }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "status": { "const": "resumable" },
            "completedAtUtc": { "type": "null" },
            "provenance": {
              "properties": {
                "resolverReceiptId": { "type": "null" }
              }
            },
            "rankedSet": {
              "properties": {
                "count": { "const": 0 },
                "candidates": { "maxItems": 0 }
              }
            },
            "choices": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "status": { "const": "ranked" },
            "completedAtUtc": { "type": "null" },
            "provenance": {
              "properties": {
                "resolverReceiptId": { "$ref": "#/$defs/sha256" }
              }
            },
            "choices": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "status": { "const": "proposal-pending" },
            "completedAtUtc": { "type": "null" },
            "provenance": {
              "properties": {
                "resolverReceiptId": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "$ref": "#/$defs/exactChoices"
        },
        {
          "properties": {
            "status": { "const": "declined-before-ranking" },
            "completedAtUtc": { "$ref": "#/$defs/timestamp" },
            "provenance": {
              "properties": {
                "resolverReceiptId": { "type": "null" }
              }
            },
            "rankedSet": {
              "properties": {
                "count": { "const": 0 },
                "candidates": { "maxItems": 0 }
              }
            },
            "choices": { "maxItems": 0 },
            "proposalPr": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "no-candidates" },
            "completedAtUtc": { "$ref": "#/$defs/timestamp" },
            "provenance": {
              "properties": {
                "resolverReceiptId": { "$ref": "#/$defs/sha256" }
              }
            },
            "rankedSet": {
              "properties": {
                "count": { "const": 0 },
                "candidates": { "maxItems": 0 }
              }
            },
            "choices": { "maxItems": 0 },
            "proposalPr": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "completed" },
            "completedAtUtc": { "$ref": "#/$defs/timestamp" },
            "provenance": {
              "properties": {
                "resolverReceiptId": { "$ref": "#/$defs/sha256" }
              }
            }
          },
          "$ref": "#/$defs/completedChoices"
        }
      ]
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "boundedText": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "boundedPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "nullableProposalPr": {
      "anyOf": [
        { "$ref": "#/$defs/proposalPr" },
        { "type": "null" }
      ]
    },
    "proposalPr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "headOid"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "headOid": { "$ref": "#/$defs/gitOid" }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "disposition", "proposalPr"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/sha256" },
        "disposition": { "enum": ["accepted", "declined", "deferred"] },
        "proposalPr": { "$ref": "#/$defs/nullableProposalPr" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": { "enum": ["declined", "deferred"] }
            }
          },
          "then": {
            "properties": {
              "proposalPr": { "type": "null" }
            }
          }
        }
      ]
    },
    "completedChoice": {
      "allOf": [
        { "$ref": "#/$defs/choice" },
        {
          "if": {
            "properties": {
              "disposition": { "const": "accepted" }
            }
          },
          "then": {
            "properties": {
              "proposalPr": { "$ref": "#/$defs/proposalPr" }
            }
          }
        }
      ]
    },
    "completedChoices": {
      "allOf": [
        { "$ref": "#/$defs/exactChoices" },
        {
          "properties": {
            "choices": {
              "items": { "$ref": "#/$defs/completedChoice" }
            }
          }
        }
      ]
    },
    "exactChoices": {
      "oneOf": [
        {
          "properties": {
            "rankedSet": { "properties": { "count": { "const": 0 } } },
            "choices": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "rankedSet": { "properties": { "count": { "const": 1 } } },
            "choices": { "minItems": 1, "maxItems": 1 }
          }
        },
        {
          "properties": {
            "rankedSet": { "properties": { "count": { "const": 2 } } },
            "choices": { "minItems": 2, "maxItems": 2 }
          }
        },
        {
          "properties": {
            "rankedSet": { "properties": { "count": { "const": 3 } } },
            "choices": { "minItems": 3, "maxItems": 3 }
          }
        },
        {
          "properties": {
            "rankedSet": { "properties": { "count": { "const": 4 } } },
            "choices": { "minItems": 4, "maxItems": 4 }
          }
        },
        {
          "properties": {
            "rankedSet": { "properties": { "count": { "const": 5 } } },
            "choices": { "minItems": 5, "maxItems": 5 }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "rank", "title", "rationale", "sources", "targets"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/sha256" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 5 },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "rationale": { "$ref": "#/$defs/boundedText" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/boundedPath" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/boundedPath" }
        }
      }
    }
  }
}
