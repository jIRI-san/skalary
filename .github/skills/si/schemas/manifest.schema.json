{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/plugins/self-improvement/schemas/manifest.schema.json",
  "title": "Self-improvement state manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generation", "pending", "inFlight", "recentRuns"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generation": { "type": "integer", "minimum": 0 },
    "pending": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/pendingDue" }
    },
    "inFlight": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/inFlightDue" }
    },
    "recentRuns": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/runReference" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "pendingDue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dueId", "repoId", "planId", "sourceCommit", "createdAtUtc", "status", "runId"],
      "properties": {
        "dueId": { "$ref": "#/$defs/sha256" },
        "repoId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "planId": { "type": "string", "pattern": "^(?:[0-9a-f]{6}|[0-9]{3})$" },
        "sourceCommit": { "$ref": "#/$defs/gitOid" },
        "createdAtUtc": { "$ref": "#/$defs/timestamp" },
        "deferUntilUtc": {
          "anyOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "status": { "const": "pending" },
        "runId": { "type": "null" }
      }
    },
    "inFlightDue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dueId", "repoId", "planId", "sourceCommit", "createdAtUtc", "status", "runId"],
      "properties": {
        "dueId": { "$ref": "#/$defs/sha256" },
        "repoId": { "type": "string", "minLength": 1, "maxLength": 512 },
        "planId": { "type": "string", "pattern": "^(?:[0-9a-f]{6}|[0-9]{3})$" },
        "sourceCommit": { "$ref": "#/$defs/gitOid" },
        "createdAtUtc": { "$ref": "#/$defs/timestamp" },
        "deferUntilUtc": {
          "anyOf": [
            { "$ref": "#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "status": { "const": "in-flight" },
        "runId": { "$ref": "#/$defs/sha256" }
      }
    },
    "runReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "dueId", "status", "path", "completedAtUtc"],
      "properties": {
        "runId": { "$ref": "#/$defs/sha256" },
        "dueId": { "$ref": "#/$defs/sha256" },
        "status": {
          "enum": ["declined-before-ranking", "no-candidates", "completed"]
        },
        "path": {
          "type": "string",
          "pattern": "^docs/self-improvement/runs/[0-9]{4}/[0-9]{2}/[0-9a-f]{64}\\.json$"
        },
        "completedAtUtc": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
