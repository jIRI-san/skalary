{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/schemas/review/terminal-status.schema.json",
  "title": "Skalary Review Terminal Status",
  "description": "Plan c21cdc D7/D12/D17. The single JSON object every terminal path writes to stdout — the schema-capability preflight as well as `Freeze` and `Publish`. Mode, exit code and state are one closed vocabulary bound to each other: `0` is a clean run or a capable host, `2` is invalid input or an absent schema capability, `3` is admission, `4` is lock/publication/unexpected failure and `5` is a valid degraded publication. Degradation is Publish-only; Freeze can return only 0, 2, 3, or 4. The capability mode has no run to name and therefore carries no `runId`; every other mode names the run it acted on, except when the caller's run id was itself rejected — an id that is not a UUID is never echoed (it is unbounded, caller-controlled text), so those statuses carry `runIdRejected: true` instead of a `runId` and are always the invalid exit `2`. The 8 KiB stdout budget is a UTF-8 byte count the emitter enforces; the per-string and per-array limits here bound it structurally but cannot express it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "exitCode", "state", "message"],
  "properties": {
    "schema": { "$ref": "#/$defs/discriminator" },
    "mode": { "$ref": "#/$defs/mode" },
    "runId": { "$ref": "#/$defs/runId" },
    "runIdRejected": { "$ref": "#/$defs/runIdRejected" },
    "exitCode": { "$ref": "#/$defs/exitCode" },
    "state": { "$ref": "#/$defs/state" },
    "message": { "$ref": "#/$defs/statusMessage" },
    "diagnostics": { "$ref": "#/$defs/statusDiagnostics" }
  },
  "allOf": [
    { "if": { "$ref": "#/$defs/capabilityMode" }, "then": { "$ref": "#/$defs/capabilityShape" }, "else": { "$ref": "#/$defs/runShape" } },
    { "if": { "$ref": "#/$defs/exitZero" }, "then": { "$ref": "#/$defs/successStates" } },
    { "if": { "$ref": "#/$defs/exitTwo" }, "then": { "$ref": "#/$defs/rejectionStates" } },
    { "if": { "$ref": "#/$defs/exitThree" }, "then": { "$ref": "#/$defs/admissionState" } },
    { "if": { "$ref": "#/$defs/exitFour" }, "then": { "$ref": "#/$defs/failedState" } },
    { "if": { "$ref": "#/$defs/exitFive" }, "then": { "$ref": "#/$defs/degradedState" } },
    { "if": { "$ref": "#/$defs/freezeMode" }, "then": { "$ref": "#/$defs/freezeShape" } }
  ],
  "$defs": {
    "discriminator": { "const": "skalary/review-terminal-status@1" },
    "mode": { "type": "string", "enum": ["capability", "freeze", "publish"] },
    "state": { "type": "string", "enum": ["capable", "incapable", "clean", "degraded", "invalid", "admission", "failed"] },
    "capabilityMode": { "properties": { "mode": { "const": "capability" } }, "required": ["mode"] },
    "freezeMode": { "properties": { "mode": { "const": "freeze" } }, "required": ["mode"] },
    "capabilityShape": {
      "not": { "required": ["runId"] },
      "properties": {
        "runIdRejected": false,
        "exitCode": { "enum": [0, 2] },
        "state": { "enum": ["capable", "incapable"] }
      }
    },
    "runShape": {
      "properties": { "state": { "enum": ["clean", "degraded", "invalid", "admission", "failed"] } },
      "if": { "required": ["runIdRejected"] },
      "then": { "$ref": "#/$defs/rejectedRunIdShape" },
      "else": { "required": ["runId"] }
    },
    "rejectedRunIdShape": {
      "not": { "required": ["runId"] },
      "properties": {
        "exitCode": { "const": 2 },
        "state": { "const": "invalid" }
      }
    },
    "freezeShape": {
      "properties": {
        "exitCode": { "enum": [0, 2, 3, 4] },
        "state": { "enum": ["clean", "invalid", "admission", "failed"] }
      }
    },
    "exitZero": { "properties": { "exitCode": { "const": 0 } }, "required": ["exitCode"] },
    "exitTwo": { "properties": { "exitCode": { "const": 2 } }, "required": ["exitCode"] },
    "exitThree": { "properties": { "exitCode": { "const": 3 } }, "required": ["exitCode"] },
    "exitFour": { "properties": { "exitCode": { "const": 4 } }, "required": ["exitCode"] },
    "exitFive": { "properties": { "exitCode": { "const": 5 } }, "required": ["exitCode"] },
    "successStates": { "properties": { "state": { "enum": ["clean", "capable"] } } },
    "rejectionStates": { "properties": { "state": { "enum": ["invalid", "incapable"] } } },
    "admissionState": { "properties": { "state": { "const": "admission" } } },
    "failedState": { "properties": { "state": { "const": "failed" } } },
    "degradedState": { "properties": { "state": { "const": "degraded" } } },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "runIdRejected": { "const": true },
    "exitCode": { "type": "integer", "enum": [0, 2, 3, 4, 5] },
    "statusMessage": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "statusDiagnostics": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  }
}
