{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jIRI-san/skalary/schemas/registry/plugin-retirement.schema.json",
  "title": "Skalary Plugin Retirements",
  "description": "Permanent retirement records. Published records are append-only and reserve plugin names.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "retiredPlugins"],
  "properties": {
    "version": {
      "const": 1
    },
    "retiredPlugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/retiredPlugin"
      }
    }
  },
  "$defs": {
    "retiredPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "retiredAt", "reason", "payloadSets", "manualResidue"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "retiredAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "payloadSets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKind", "sourceIdentity", "ref", "version", "files"],
            "properties": {
              "sourceKind": {
                "type": "string",
                "enum": ["github", "local"]
              },
              "sourceIdentity": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\s?#@]+$"
              },
              "ref": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["dest", "sha256"],
                  "properties": {
                    "dest": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "manualResidue": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "remedy"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["scaffold", "copilot-cli", "approval-key"]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "remedy": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
